%% Talk list (workshops.tex). Left column = year (shown once per year via skipsamekey).
%% Line 1: title (event name for attendances). Line 2: ROLE · event, where · date.
%% Styling per category lives only here:
%%   \cvinvited{year}{role}{title}{event}{where}{day-month}   accent label, bold title
%%   \cvtalk{year}{title}{event}{where}{day-month}            grey label, plain title
%%   \cvposter{year}{title}{event}{where}{day-month}          grey label, plain title
%%   \cvattended{year}{event}{where}{day-month}               grey label and text, no title
\newcommand{\cv@role}[2]{{\color{#1}\sffamily\scriptsize\bfseries\MakeUppercase{#2}}}
\newcommand{\cv@dot}{\ \textperiodcentered\ }
\newcommand{\cvinvited}[6]{\entry*[#1]{\textbf{#3}\par
  \cv@role{MarkerColour!80!black}{#2}\cv@dot\emph{#4}, #5\cv@dot#6}}
\newcommand{\cvtalk}[5]{\entry*[#1]{#2\par
  \cv@role{black!60}{Talk}\cv@dot\emph{#3}, #4\cv@dot#5}}
\newcommand{\cvposter}[5]{\entry*[#1]{#2\par
  \cv@role{black!60}{Poster}\cv@dot\emph{#3}, #4\cv@dot#5}}
\newcommand{\cvattended}[4]{\entry*[#1]{\leavevmode\color{black!65}#2\par
  \cv@role{black!60}{Participant}\cv@dot#3\cv@dot#4}}

\newcommand{\makerubrichead}[1]{\vskip\baselineskip\@@rubrichead{#1}}

