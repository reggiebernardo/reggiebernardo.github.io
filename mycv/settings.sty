\newcommand*\circled[1]{\tikz[baseline=(char.base)]{
   \node[shape=circle,text=white,fill=MarkerColour!80!black,font=\sffamily\scriptsize\bfseries,inner sep=1pt,text height=1.35ex,minimum width=1.5em,text centered] (char) {#1};}}
   
%%% Bibliography: plain BibTeX with JHEP.bst (no biblatex).
%% \cvbibliography{<style>}{<bib>} writes the aux lines for `bibtex main` and cites every entry.
\newcommand{\cvbibliography}[2]{\AtBeginDocument{%
  \if@filesw
    \immediate\write\@auxout{\string\bibstyle{#1}}%
    \immediate\write\@auxout{\string\bibdata{#2}}%
    \immediate\write\@auxout{\string\citation{*}}%
  \fi}}

\newcounter{bibitem}
\newlength{\cvbibhang}
\setlength{\cvbibhang}{2.5em}
\newlength{\cvbibitemsep}
\setlength{\cvbibitemsep}{1.5ex}

% JHEP.bst is edited to emit \bibitem{key}{type}{body}; the body is typeset only if its type matches.
\long\def\cv@bibitem#1#2#3{%
  \def\cv@thistype{#2}%
  \ifx\cv@thistype\cv@bibtype
    \stepcounter{bibitem}%
    \par\noindent\hangindent=\cvbibhang\hangafter=1\relax
    \makebox[\cvbibhang][l]{\circled{\thebibitem}}#3\par
    \vskip\cvbibitemsep
  \fi}

% \cvprintbib{article} or \cvprintbib{inproceedings}: number and print only that entry type.
\newcommand{\cvprintbib}[1]{%
  \begingroup
    \def\cv@bibtype{#1}%
    \setcounter{bibitem}{0}%
    \let\bibitem\cv@bibitem
    \def\thebibliography##1{}%
    \def\endthebibliography{}%
    \@input{\jobname.bbl}%
  \endgroup}

% \cvbibentry{key}: inline JHEP-formatted entry (no number), e.g. inside \entry in highlights.tex.
\long\def\cv@bibitem@one#1#2#3{%
  \def\cv@thiskey{#1}%
  \ifx\cv@thiskey\cv@wantkey #3\fi}

\newcommand{\cvbibentry}[1]{%
  \begingroup
    \def\cv@wantkey{#1}%
    \let\bibitem\cv@bibitem@one
    \def\thebibliography##1{}%
    \def\endthebibliography{}%
    \@input{\jobname.bbl}%
  \endgroup}

